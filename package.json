{
  "name": "@hanzo/design",
  "version": "0.2.0",
  "description": "Hanzo Design System \u2014 monochrome, dark-default tokens + components + brand assets, the single source of truth for every Hanzo surface. CSS + typed programmatic tokens.",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/design.git"
  },
  "homepage": "https://hanzo.ai",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./prompts/*": "./prompts/*",
    "./content/*": "./content/*",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "gen": "node scripts/gen-tokens.mjs",
    "build": "npm run gen && tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "styles.css",
    "tokens",
    "components",
    "prompts",
    "content",
    "docs",
    "assets",
    "guidelines",
    "ui_kits"
  ],
  "keywords": [
    "hanzo",
    "design-system",
    "design-tokens",
    "brand",
    "monochrome"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}