{
  "name": "@hanzo/design",
  "version": "0.1.0",
  "description": "Hanzo Design System \u2014 monochrome, dark-default tokens + components + brand assets, the single source of truth for every Hanzo surface.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hanzoai/design.git"
  },
  "homepage": "https://hanzo.ai",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./styles.css": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./components/*": "./components/*",
    "./prompts/*": "./prompts/*",
    "./content/*": "./content/*",
    "./assets/*": "./assets/*"
  },
  "files": [
    "styles.css",
    "tokens",
    "components",
    "prompts",
    "content",
    "docs",
    "assets",
    "guidelines",
    "ui_kits"
  ],
  "keywords": [
    "hanzo",
    "design-system",
    "design-tokens",
    "brand",
    "monochrome"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}