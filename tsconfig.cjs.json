{
  // The second of two emits. `tsc` writes one module format per run and one
  // outDir per run, so CommonJS is a separate pass over the same sources; the
  // ESM pass owns the declarations, this one emits code only. Module resolution
  // comes from the base and is the same for both passes.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "outDir": "./dist-cjs",
    "declaration": false,
    "declarationMap": false
  }
}
